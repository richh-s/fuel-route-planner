                  "const body = pm.response.json();",
                  "pm.test(\"has route geometry\", () => pm.expect(body.route.geometry.type).to.eql(\"LineString\"));",
                  "pm.test(\"every stop is within the 500-mile range\", () => {",
                  "  let last = 0;",
                  "  body.fuel.stops.forEach(s => { pm.expect(s.mile_marker - last).to.be.at.most(500); last = s.mile_marker; });",
                  "  pm.expect(body.route.distance_miles - last).to.be.at.most(500);",
                  "});",
                  "pm.test(\"total cost = sum of stops\", () => {",
