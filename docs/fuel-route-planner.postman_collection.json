                  "  pm.expect(body.fuel.total_cost_usd).to.be.closeTo(sum, 0.05);",
                  "});",
                  "pm.test(\"at most one routing API call\", () => pm.expect(body.meta.routing_api_calls).to.be.at.most(1));",
                  "pm.collectionVariables.set(\"map_url\", body.map_url);",
