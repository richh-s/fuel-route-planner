{
  "info": {
    "name": "Fuel Route Planner API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Plan US driving routes with the cheapest fuel stops (500-mile range, 10 mpg).\n\nSet `base_url` (default http://localhost:8000). Run a trip request, then open `{{map_url}}` in a browser to see the map."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "map_url",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Trips",
      "item": [
        {
          "name": "Los Angeles → New York (cross-country)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=Los Angeles, CA&finish=New York, NY",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Los Angeles, CA"
                },
                {
                  "key": "finish",
                  "value": "New York, NY"
                }
              ]
            },
            "description": "Coast to coast: several fuel stops. Send it twice: the second call is served from cache (meta.routing_api_calls = 0)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has route geometry\", () => pm.expect(body.route.geometry.type).to.eql(\"LineString\"));",
                  "pm.test(\"every stop is within the 500-mile range\", () => {",
                  "  let last = 0;",
                  "  body.fuel.stops.forEach(s => { pm.expect(s.mile_marker - last).to.be.at.most(500); last = s.mile_marker; });",
                  "  pm.expect(body.route.distance_miles - last).to.be.at.most(500);",
                  "});",
                  "pm.test(\"total cost = sum of stops\", () => {",
                  "  const sum = body.fuel.stops.reduce((t, s) => t + s.cost_usd, 0);",
                  "  pm.expect(body.fuel.total_cost_usd).to.be.closeTo(sum, 0.05);",
                  "});",
                  "pm.test(\"at most one routing API call\", () => pm.expect(body.meta.routing_api_calls).to.be.at.most(1));",
                  "pm.collectionVariables.set(\"map_url\", body.map_url);",
                  "console.log(`Cost $${body.fuel.total_cost_usd}, ${body.fuel.number_of_stops} stops, map: ${body.map_url}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dallas → Chicago (JSON body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Chicago, IL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/route/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has route geometry\", () => pm.expect(body.route.geometry.type).to.eql(\"LineString\"));",
                  "pm.test(\"every stop is within the 500-mile range\", () => {",
                  "  let last = 0;",
                  "  body.fuel.stops.forEach(s => { pm.expect(s.mile_marker - last).to.be.at.most(500); last = s.mile_marker; });",
                  "  pm.expect(body.route.distance_miles - last).to.be.at.most(500);",
                  "});",
                  "pm.test(\"total cost = sum of stops\", () => {",
                  "  const sum = body.fuel.stops.reduce((t, s) => t + s.cost_usd, 0);",
                  "  pm.expect(body.fuel.total_cost_usd).to.be.closeTo(sum, 0.05);",
                  "});",
                  "pm.test(\"at most one routing API call\", () => pm.expect(body.meta.routing_api_calls).to.be.at.most(1));",
                  "pm.collectionVariables.set(\"map_url\", body.map_url);",
                  "console.log(`Cost $${body.fuel.total_cost_usd}, ${body.fuel.number_of_stops} stops, map: ${body.map_url}`);"
                ]
              }
            }
          ]
        },
