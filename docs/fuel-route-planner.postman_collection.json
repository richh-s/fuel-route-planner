                  "pm.test(\"no stops needed\", () => pm.expect(pm.response.json().fuel.number_of_stops).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Route map (HTML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/route/map/?start=Los Angeles, CA&finish=New York, NY",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "route",
                "map"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Los Angeles, CA"
                },
                {
                  "key": "finish",
                  "value": "New York, NY"
                }
              ]
            },
            "description": "Interactive Leaflet map. Best opened in a browser (Postman shows the HTML)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Unknown city → 422",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/route/?start=Atlantis, TX&finish=Chicago, IL",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
