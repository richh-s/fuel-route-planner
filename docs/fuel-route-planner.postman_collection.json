                "route"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "Atlantis, TX"
                },
                {
                  "key": "finish",
                  "value": "Chicago, IL"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"error code is invalid_location\", () => pm.expect(pm.response.json().error.code).to.eql(\"invalid_location\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Outside the USA → 422",
          "request": {
