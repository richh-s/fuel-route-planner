# Copy to .env for local development: cp .env.example .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=true

# Routing API (free OSRM demo server by default; self-host OSRM for production traffic)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15
ROUTE_CACHE_TTL_SECONDS=86400

# Vehicle and planning assumptions
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
DEFAULT_CORRIDOR_MILES=10
STATION_STRETCH_MILES=25
FUEL_STOP_PENALTY_USD=15

# Optional: share the route cache and rate-limit counters between workers
# REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
