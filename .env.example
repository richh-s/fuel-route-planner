DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing API (free OSRM demo server by default)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15
ROUTE_CACHE_TTL_SECONDS=86400

# Vehicle assumptions
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
DEFAULT_CORRIDOR_MILES=10
STATION_STRETCH_MILES=25
FUEL_STOP_PENALTY_USD=15

# Optional: share the route cache between workers
# REDIS_URL=redis://localhost:6379/0
