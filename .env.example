# Copy to .env for local development: cp .env.example .env
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=true

# Routing API (free OSRM demo server by default; self-host OSRM for production, see docs/deployment.md)
OSRM_BASE_URL=https://router.project-osrm.org
# Worst case per trip: (OSRM_RETRIES + 1) x (connect + read timeout). Keep it well under 30 s.
OSRM_CONNECT_TIMEOUT_SECONDS=2
OSRM_TIMEOUT_SECONDS=5
OSRM_RETRIES=1
ROUTE_CACHE_TTL_SECONDS=86400

# Vehicle and planning assumptions
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
DEFAULT_CORRIDOR_MILES=10
STATION_STRETCH_MILES=25
FUEL_STOP_PENALTY_USD=15

# Access control. Comma-separated keys; when set, trip endpoints require one (X-API-Key header).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=
# Browser frontends on other origins that may call the API
# CORS_ALLOWED_ORIGINS=https://app.your-domain.example

# Requests per API key (or per client IP when no key is used) for the trip endpoints
TRIP_PLAN_RATE_LIMIT=30/minute
# Number of reverse proxies in front of the app (for correct client IPs)
# NUM_PROXIES=1

# Shared route cache and rate-limit counters (required with more than one worker)
# REDIS_URL=redis://localhost:6379/0

# Fuel prices: how often workers check for a new import
STATION_INDEX_REFRESH_SECONDS=60

# Observability
LOG_LEVEL=INFO
# LOG_FORMAT=json            # default: json in production, text with DEBUG
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# METRICS_TOKEN=             # enables /metrics (Prometheus), sent as a bearer token

# Map page tiles. The default OpenStreetMap server is for light use only; use a tile provider in production.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Admin site (off by default; needs a persistent database, see docs/deployment.md)
# DJANGO_ADMIN_ENABLED=true
